# En-têtes HTTP appliqués par Cloudflare Pages (ignorés par GitHub Pages).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000

# Contenu modifié depuis l'admin : toujours revérifié, pour que les changements apparaissent tout de suite
/data/*
  Cache-Control: no-cache

/admin.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache

# Cloudflare Pages sert aussi l'admin à l'adresse courte /admin
/admin
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache

/img/*
  Cache-Control: public, max-age=604800
